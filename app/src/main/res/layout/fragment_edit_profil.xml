<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ImageButton
        android:id="@+id/btnBackEditProfil"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:src="@drawable/ic_back"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="#F37321" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Profile"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#F37321"
        android:layout_marginStart="16dp"
        app:layout_constraintBottom_toBottomOf="@id/btnBackEditProfil"
        app:layout_constraintStart_toEndOf="@id/btnBackEditProfil"
        app:layout_constraintTop_toTopOf="@id/btnBackEditProfil" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutAvatar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBackEditProfil">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivEditFoto"
            android:layout_width="130dp"
            android:layout_height="130dp"
            android:src="@drawable/placeholder_avatar"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btnAmbilFoto"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_camera"
            android:background="#FFCCBC"
            android:padding="8dp"
            app:tint="#F37321"
            app:shapeAppearanceOverlay="@style/CircleImageView"
            app:layout_constraintBottom_toBottomOf="@id/ivEditFoto"
            app:layout_constraintEnd_toEndOf="@id/ivEditFoto" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="32dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/layoutAvatar">

        <EditText
            android:id="@+id/etEditNama"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_search_input"
            android:paddingHorizontal="24dp"
            android:hint="Nama Mahasiswa"
            android:textColor="#333333"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Email Address"
            android:textColor="#FFCCBC"
            android:textSize="12sp"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etEditEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_search_input"
            android:paddingHorizontal="24dp"
            android:hint="email@widyatama.ac.id"
            android:textColor="#333333"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSaveChanges"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="40dp"
            android:text="Save Changes"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:backgroundTint="#F37321"
            app:cornerRadius="28dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>