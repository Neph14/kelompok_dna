<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTopBarHome"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/ivLogoLitera"
            android:layout_width="wrap_content"
            android:layout_height="24dp"
            android:adjustViewBounds="true"
            android:src="@drawable/icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageView
            android:id="@+id/ivLogoUtama"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:adjustViewBounds="true"
            android:src="@drawable/logoutama"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerHome"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBarHome"
        app:layout_constraintBottom_toBottomOf="parent">
        <include layout="@layout/shimmer_home" />
    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollHomeContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layoutTopBarHome"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvSalamMahasiswa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="12dp">

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_search_input">

                    <ImageView
                        android:id="@+id/ivIconSearchManual"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_search"
                        app:tint="#888888" />

                    <EditText
                        android:id="@+id/etSearchHome"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent" android:hint="Cari judul buku atau penulis"
                        android:paddingStart="40dp" android:paddingEnd="16dp"
                        android:textSize="14sp"
                        android:inputType="text"
                        android:importantForAutofill="no"
                        android:focusable="false"
                        android:clickable="true" />
                </RelativeLayout>

                <ImageButton
                    android:id="@+id/btnKeranjangPinjam"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_cart"
                    android:background="@drawable/bg_button_back"
                    app:tint="#F37321"
                    android:contentDescription="Daftar Ingin Pinjam" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvJudulKategori"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jurusan Anda" android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvBukuSistemInformasi"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_buku_horizontal" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:scrollbars="none"
                android:paddingHorizontal="16dp"
                android:clipToPadding="false">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnKategoriSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Semua"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#F37321"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="19dp" />

                    <Button
                        android:id="@+id/btnKategoriModul"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Modul"
                        android:textAllCaps="false"
                        android:textColor="#555555"
                        android:backgroundTint="#EAEAEA"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="19dp" />

                    <Button
                        android:id="@+id/btnKategoriNovel"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Novel"
                        android:textAllCaps="false"
                        android:textColor="#555555"
                        android:backgroundTint="#EAEAEA"
                        android:layout_marginEnd="8dp"
                        app:cornerRadius="19dp" />

                    <Button
                        android:id="@+id/btnKategoriKomik"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="Komik"
                        android:textAllCaps="false"
                        android:textColor="#555555"
                        android:backgroundTint="#EAEAEA"
                        app:cornerRadius="19dp" />
                </LinearLayout>
            </HorizontalScrollView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rekomendasi Untukmu"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="24dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRekomendasiHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_buku_vertikal" />

            <TextView
                android:id="@+id/tvDataKosongHome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginHorizontal="16dp"
                android:text="Maaf, buku untuk kategori ini belum tersedia."
                android:textColor="#888888"
                android:textSize="14sp"
                android:textStyle="italic"
                android:gravity="center"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>