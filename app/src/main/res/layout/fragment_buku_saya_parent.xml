<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:id="@+id/headerBukuSaya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackBukuSaya"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_button_back"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"
            app:tint="#000000" />

        <TextView
            android:id="@+id/tvTitleBukuSaya"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:text="Buku Saya"
            android:textColor="#2D3E50"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:id="@+id/lineHeader"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toBottomOf="@id/headerBukuSaya" />

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabBukuSaya"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@color/white"
        app:tabBackground="@color/white"
        app:tabIndicatorColor="#F37321"
        app:tabIndicatorHeight="3dp"
        app:tabIndicatorFullWidth="true"
        app:tabSelectedTextColor="#F37321"
        app:tabTextColor="#888888"
        app:tabRippleColor="@android:color/transparent"
        app:tabTextAppearance="@style/CustomTabTextStyle"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:layout_constraintTop_toBottomOf="@id/lineHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Buku Aktif" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="History" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/containerChildBuku"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tabBukuSaya"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>