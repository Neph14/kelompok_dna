<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Header Filter -->
    <LinearLayout
        android:id="@+id/layoutFilterTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBackFromFilter"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_button_back"
            app:tint="#000000" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Filter Kategori"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2D3E50"
            android:layout_marginStart="24dp" />
    </LinearLayout>

    <!-- Category List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/layoutFilterTopBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <RadioGroup
            android:id="@+id/rgKategoriFilterOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbModul"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Modul"
                android:textSize="18sp"
                android:textColor="#2D3E50"
                android:background="@drawable/bg_filter_option"
                android:layout_marginBottom="16dp"
                android:paddingStart="20dp"
                android:buttonTint="@color/white" />

            <RadioButton
                android:id="@+id/rbNovel"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Novel"
                android:textSize="18sp"
                android:textColor="#2D3E50"
                android:background="@drawable/bg_filter_option"
                android:layout_marginBottom="16dp"
                android:paddingStart="20dp"
                android:buttonTint="@color/white" />

            <RadioButton
                android:id="@+id/rbKomik"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Komik"
                android:textSize="18sp"
                android:textColor="#2D3E50"
                android:background="@drawable/bg_filter_option"
                android:layout_marginBottom="16dp"
                android:paddingStart="20dp"
                android:buttonTint="@color/white" />

            <RadioButton
                android:id="@+id/rbJurnal"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:text="Jurnal"
                android:textSize="18sp"
                android:textColor="#2D3E50"
                android:background="@drawable/bg_filter_option"
                android:layout_marginBottom="16dp"
                android:paddingStart="20dp"
                android:buttonTint="@color/white" />

        </RadioGroup>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>