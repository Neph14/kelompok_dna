<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <CheckBox
            android:id="@+id/cbItemKeranjang"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="#F37321" />

        <ImageView
            android:id="@+id/ivCoverKeranjang"
            android:layout_width="60dp"
            android:layout_height="85dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="8dp"
            android:src="@drawable/placeholder_buku" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvJudulKeranjang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Statistika dan Probabilitas"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvPenulisKeranjang"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr. Boediono"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="2dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <ImageButton
                    android:id="@+id/btnKurangBuku"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    app:tint="#888888"/>

                <TextView
                    android:id="@+id/tvJumlahBuku"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:text="1"
                    android:textColor="#333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnTambahBuku"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_add"
                    android:background="@android:color/transparent"
                    android:padding="4dp"
                    app:tint="#F37321"/>
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnHapusKeranjang"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@android:drawable/ic_menu_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            app:tint="#FF4D4D"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:contentDescription="Hapus Buku" />

    </LinearLayout>
</androidx.cardview.widget.CardView>